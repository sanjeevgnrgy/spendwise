# Template for your local .env file.
# Copy it:  Copy-Item .env.example .env   then fill in real values in .env.
# .env is git-ignored, so secrets never get committed; this file is the shared,
# secret-free list of what the app expects.

# Gemini API key from https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=
# Model ID from https://aistudio.google.com/docs/models (this one is available on the free tier)
GEMINI_MODEL=gemini-3.8-flash

# Optional. Turns on MCP over HTTP at /mcp/ (for MCP Inspector or another app), protected by this
# shared secret: clients must send "Authorization: Bearer <token>". Unset: no /mcp/ over HTTP at all
# (the assistant and stdio don't need it). Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_TOKEN=

# Optional. Only if the expense tools run as a separate MCP server: its URL (the assistant then sends
# MCP_TOKEN to it). Unset: the assistant calls this app's own MCP server in-process, with no network hop.
# Keep the trailing slash: /mcp redirects to /mcp/ first.
# MCP_URL=http://127.0.0.1:8001/mcp/

# Optional. Leave unset to use the SQLite file backend/spendwise.db.
# Set it to switch databases without code changes, e.g. Postgres in a later phase.
# DATABASE_URL=

# Optional. The folder uploaded receipts are kept in (by random names). Leave unset for backend/uploads.
# UPLOADS_DIR=

# Sign-in (Phase 22): the OpenID Connect provider people sign in with. Setup: docs/identity_provider.md.
# Until the issuer, client id, secret and an encryption key are all set, nobody can sign in, and every API
# route answers 401. Never commit real values.
# OIDC_ISSUER=https://<your instance>
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Optional: scopes every sign-in asks for (space-separated).
# OIDC_SCOPES=openid profile email
# Optional: the sign-in page's buttons, a JSON list; each adds scopes or parameters so the provider skips to it.
# OIDC_LOGIN_OPTIONS=[{"key":"google","label":"Google","extra_scopes":["<the provider's hint scope>"]}]
# Optional: where the tokens list roles, and the role a person must have to sign in.
# OIDC_ROLE_CLAIM=
# OIDC_REQUIRED_ROLE=
# The origin people open the web app at (no path). Default: the Vite dev server.
# PUBLIC_URL=http://localhost:5173
# Keys that seal the ID token each session keeps (Fernet, a JSON list, newest first). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_ENCRYPTION_KEYS=["<key>"]
# Optional. The cookies' Secure flag; leave it on (browsers accept Secure cookies on http://localhost).
# COOKIE_SECURE=true
