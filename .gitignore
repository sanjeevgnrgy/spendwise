# The virtual environment is rebuilt from requirements.txt, so never commit it.
.venv/

# Python's compiled bytecode cache, regenerated automatically.
__pycache__/
*.py[cod]

# pytest's own cache (remembers last failures for --lf), regenerated automatically.
.pytest_cache/

# Real secrets live here. Only .env.example (no real values) is committed.
.env

# Local SQLite database: your data, recreated by the app and backend/seed.py.
*.db
*.db-journal
