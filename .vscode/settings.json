{
  // Use the project's own venv for running code and for import checking.
  // Windows path; on macOS/Linux it would be ${workspaceFolder}/.venv/bin/python.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  // The backend imports itself as "app.…", and the app package lives in backend/.
  "python.analysis.extraPaths": ["backend"]
}
