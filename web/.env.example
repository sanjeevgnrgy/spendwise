# Template for web/.env (git-ignored). Settings for the Next.js server (npm run dev, npm run build), read in Node.
# The browser code reads no variables from here: it calls the API on its own origin.
# Never put a secret in a NEXT_PUBLIC_ variable: those would reach the browser code, which anyone can read.

# Where the backend runs. Next.js forwards /api/v1/... there, so the web app and the API share one origin.
# Read when `npm run dev` starts, and compiled in by `npm run build` (set it before building for production).
# Leave unset for http://127.0.0.1:8000 (where .\run.ps1 starts it).
# API_PROXY_TARGET=http://127.0.0.1:8001

# The address people open the web app at: link previews, robots.txt and the sitemap use it, and an https address
# turns on HSTS for the pages. The same value as the backend's PUBLIC_URL. Leave unset for http://localhost:5173
# (npm run dev). Set it before building for production.
# PUBLIC_URL=https://spendwise.example
